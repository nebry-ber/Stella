# Caddy ottiene e rinnova da solo il certificato HTTPS (Let's Encrypt) per il dominio.
{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode zstd gzip
	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
	reverse_proxy app:3000
}

# Altre app sullo stesso VPS: un file .caddy ciascuna nella cartella sites/ (vedi sites/LEGGIMI.txt)
import /etc/caddy/sites/*.caddy
